{
  "name": "ttobak-kids",
  "version": "1.2.0",
  "private": true,
  "description": "Kid-friendly Korean pronunciation trainer web app with Android APK packaging via Capacitor",
  "scripts": {
    "serve": "npx http-server . -p 8080 -c-1",
    "serve:py": "python -m http.server 8080",
    "android:init": "npx cap add android && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:debug:win": "cd android && gradlew.bat assembleDebug",
    "aab:release": "cd android && ./gradlew bundleRelease",
    "aab:release:win": "cd android && gradlew.bat bundleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "http-server": "^14.1.1"
  }
}
